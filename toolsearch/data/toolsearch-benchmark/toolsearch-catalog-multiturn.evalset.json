{
  "evalSetId": "toolsearch-catalog-multiturn",
  "name": "toolsearch-catalog-multiturn",
  "description": "Natural multi-turn chats for the refactored tool_search plugin over a 7-namespace deferred-tool catalog (filesystem, git, document, process, network, iam, crm) plus no-namespace default tools. Each case is one session; each turn's expected tool(s) drive the tool-trajectory metric (regex, subset-matching, so 'tool_a|tool_b' accepts either).",
  "evalCases": [
    {
      "evalId": "filesystem",
      "conversation": [
        {
          "invocationId": "fs-01",
          "userContent": { "role": "user", "content": "Save the text 'hello world' to notes.txt for me." },
          "tools": [{ "id": "tool_use_1", "name": "write_file" }]
        },
        {
          "invocationId": "fs-02",
          "userContent": { "role": "user", "content": "Now read the contents of config.yaml back to me." },
          "tools": [{ "id": "tool_use_2", "name": "read_file" }]
        },
        {
          "invocationId": "fs-03",
          "userContent": { "role": "user", "content": "List all the files in the src directory." },
          "tools": [{ "id": "tool_use_3", "name": "list_directory" }]
        },
        {
          "invocationId": "fs-04",
          "userContent": { "role": "user", "content": "Search for TODO comments across the code." },
          "tools": [{ "id": "tool_use_4", "name": "search_file_content|find_files" }]
        },
        {
          "invocationId": "fs-05",
          "userContent": { "role": "user", "content": "Rename a.txt to b.txt." },
          "tools": [{ "id": "tool_use_5", "name": "move_file" }]
        },
        {
          "invocationId": "fs-06",
          "userContent": { "role": "user", "content": "Delete the temporary file tmp.log." },
          "tools": [{ "id": "tool_use_6", "name": "delete_file" }]
        },
        {
          "invocationId": "fs-07",
          "userContent": { "role": "user", "content": "Create a new build directory." },
          "tools": [{ "id": "tool_use_7", "name": "create_directory" }]
        },
        {
          "invocationId": "fs-08",
          "userContent": { "role": "user", "content": "Check the size and last-modified time of notes.txt." },
          "tools": [{ "id": "tool_use_8", "name": "get_file_info" }]
        },
        {
          "invocationId": "fs-09",
          "userContent": { "role": "user", "content": "Append a log line to the end of notes.txt." },
          "tools": [{ "id": "tool_use_9", "name": "append_file" }]
        }
      ],
      "sessionInput": { "appName": "toolsearch-benchmark", "userId": "user" }
    },
    {
      "evalId": "git",
      "conversation": [
        {
          "invocationId": "git-01",
          "userContent": { "role": "user", "content": "Check what changes have been made in the current repository." },
          "tools": [{ "id": "tool_use_1", "name": "git_status" }]
        },
        {
          "invocationId": "git-02",
          "userContent": { "role": "user", "content": "Show me the uncommitted diff." },
          "tools": [{ "id": "tool_use_2", "name": "git_diff" }]
        },
        {
          "invocationId": "git-03",
          "userContent": { "role": "user", "content": "Stage the file main.go for the next commit." },
          "tools": [{ "id": "tool_use_3", "name": "git_add" }]
        },
        {
          "invocationId": "git-04",
          "userContent": { "role": "user", "content": "Create a commit with the message 'fix bug'." },
          "tools": [{ "id": "tool_use_4", "name": "git_commit" }]
        },
        {
          "invocationId": "git-05",
          "userContent": { "role": "user", "content": "View the recent commit history." },
          "tools": [{ "id": "tool_use_5", "name": "git_log" }]
        },
        {
          "invocationId": "git-06",
          "userContent": { "role": "user", "content": "Switch to the develop branch." },
          "tools": [{ "id": "tool_use_6", "name": "git_checkout" }]
        },
        {
          "invocationId": "git-07",
          "userContent": { "role": "user", "content": "Push my local commits to remote." },
          "tools": [{ "id": "tool_use_7", "name": "git_push" }]
        },
        {
          "invocationId": "git-08",
          "userContent": { "role": "user", "content": "Pull the latest code from remote." },
          "tools": [{ "id": "tool_use_8", "name": "git_pull" }]
        },
        {
          "invocationId": "git-09",
          "userContent": { "role": "user", "content": "Show me who last modified each line of main.go." },
          "tools": [{ "id": "tool_use_9", "name": "git_blame" }]
        }
      ],
      "sessionInput": { "appName": "toolsearch-benchmark", "userId": "user" }
    },
    {
